rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =================================================================
    // פונקציות — מערכת הציוד הקיימת (users / sites / equipment / operators / meta)
    // =================================================================
    function isSignedIn() { return request.auth != null; }
    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isAdmin() { return isSignedIn() && myProfile().role == 'admin'; }
    // משתמש של המערכת הקיימת = יש לו מסמך באוסף users
    function isLegacyUser() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // =================================================================
    // פונקציות — מערכת בקרת המנופים (craneUsers)
    // =================================================================
    function craneMe() { return get(/databases/$(database)/documents/craneUsers/$(request.auth.uid)).data; }
    // חשבונות קבועים בעלי הרשאות מלאות (מפתח + מנהל מערך) — תואם ל-config.js
    function isFixedAdmin() {
      return isSignedIn() && request.auth.token.email_verified == true
        && request.auth.token.email in ['itai.rosenblum@gmail.com', 'filiba111@gmail.com'];
    }
    function craneApproved() {
      return isFixedAdmin() || (isSignedIn()
        && exists(/databases/$(database)/documents/craneUsers/$(request.auth.uid))
        && craneMe().status == 'approved');
    }
    function craneRole() { return craneMe().role; }
    function craneAdmin() { return isFixedAdmin() || (craneApproved() && craneRole() == 'admin'); }
    function craneManager() { return craneAdmin() || (craneApproved() && craneRole() == 'site_manager'); }
    function onlyKeys(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }

    // =================================================================
    // מערכת הציוד הקיימת — הרשאות כתיבה ללא שינוי.
    // קריאה: משתמשי המערכת הקיימת + משתמשים מאושרים במערכת המנופים.
    // =================================================================
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if isAdmin();
    }
    match /sites/{siteId} {
      allow read: if isLegacyUser() || craneApproved();
      allow write: if isAdmin();
    }
    match /equipment/{eqId} {
      allow read: if isLegacyUser() || craneApproved();
      allow write: if isAdmin();
    }
    match /operators/{opId} {
      // מפעיל במערכת המנופים רואה רק את הרשומה שלו (בדיקת רישיון)
      allow read: if isLegacyUser() || craneManager()
        || (craneApproved() && craneMe().operatorRecordId == opId);
      allow write: if isAdmin();
    }
    match /meta/{docId} {
      allow read: if isLegacyUser();
      allow write: if isAdmin();
    }

    // =================================================================
    // מערכת בקרת המנופים
    // =================================================================
    match /craneUsers/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || craneAdmin());

      // חשבון קבוע יוצר לעצמו מסמך מנהל; כל השאר — בקשת הרשאה בסטטוס ממתין
      allow create: if (isFixedAdmin() && request.auth.uid == uid) || isSignedIn() && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.role == 'pending'
        && request.resource.data.status == 'pending'
        && request.resource.data.assignedSite == ''
        && request.resource.data.requestedRole in ['operator', 'site_manager']
        && !('operatorRecordId' in request.resource.data);

      // רק מנהל מערך משנה תפקיד/סטטוס/אתר/קישור; משתמש מעדכן רק שם, טלפון, העדפות התראה ומזהי מכשירים
      allow update: if craneAdmin()
        || (isSignedIn() && request.auth.uid == uid && onlyKeys(['name', 'phone', 'notifyPrefs', 'fcmTokens', 'updatedAt']));

      allow delete: if craneAdmin();
    }

    match /craneSettings/{id} {
      allow read: if craneApproved();
      allow write: if craneAdmin();
    }

    match /cranes/{craneId} {
      allow read: if craneApproved();
      allow create, delete: if craneAdmin();
      allow update: if craneAdmin()
        // מנהל אתר / מפעיל באתר המנוף: רק סטטוס הפעלה ורענון תאריך תסקיר
        || (craneApproved()
            && onlyKeys(['currentStatus', 'activeOperationId', 'inspectionUntil', 'inspectionSyncedAt', 'updatedAt'])
            && request.resource.data.currentStatus in ['available', 'in_use', 'maintenance']
            && (craneManager() || resource.data.site == craneMe().assignedSite));
    }

    match /operations/{opId} {
      allow read: if craneManager()
        || (craneApproved() && resource.data.operatorId == request.auth.uid);

      // מפעיל פותח הפעלה רק בשמו, באתר שלו, ועם רשומת המנופאי המקושרת אליו
      allow create: if craneApproved()
        && request.resource.data.operatorId == request.auth.uid
        && request.resource.data.status == 'active'
        && request.resource.data.site == craneMe().assignedSite
        && request.resource.data.preCheck.operatorRecordId == craneMe().get('operatorRecordId', null);

      allow update: if craneAdmin()
        // המפעיל סוגר את ההפעלה שלו
        || (craneApproved()
            && resource.data.operatorId == request.auth.uid
            && resource.data.status == 'active'
            && request.resource.data.status == 'completed'
            && onlyKeys(['status', 'endTime', 'postCheck']))
        // מנהל אתר — סגירה כפויה
        || (craneManager()
            && resource.data.status == 'active'
            && request.resource.data.status == 'completed'
            && onlyKeys(['status', 'endTime', 'postCheck']));

      allow delete: if craneAdmin();
    }
  }
}
